.DS_Store
.idea/
.vscode/
*.swp
*.swo
.env
.env.local

# ──────────────── Build / generated ────────────────
# OpenAPI client is regenerated via `npm run gen:api`; keep it in tree only
# if you want type-check to pass on a fresh clone without the backend up.
# Uncomment to ignore:
# frontend/src/api/schema.d.ts
