# ──────────────── Python / FastAPI ────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.python-version
.pytest_cache/

# Local DB (SQLite) — instance data, not source
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

