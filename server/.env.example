# Admin UI login (required for /admin and protected API routes).
# No quotes around values. Restart uvicorn after edits.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string
ADMIN_JWT_SECRET=change-me-to-another-long-random-string

# Empty = same-origin UI/API. Vite proxies /api, so no extra origin is needed.
# For a separately hosted UI use exact origins (no trailing slash or wildcard).
CORS_ALLOWED_ORIGINS=
# Per-workbook import limits; also cap incoming HTTP bodies at your proxy.
TDS_IMPORT_MAX_FILE_BYTES=26214400
TDS_IMPORT_MAX_UNCOMPRESSED_BYTES=104857600
TDS_IMPORT_MAX_ARCHIVE_ENTRIES=1000
TDS_IMPORT_MAX_SHEETS=100
TDS_IMPORT_MAX_ROWS=100000

# QR Attendance: full organization URL ending in /api/v1/external/employees.
# Example: https://attendance.example.com/acme/api/v1/external/employees
# Server GETs with rfid, active=true, limit=2, offset=0.
# HTTPS required except loopback development URLs. Empty = not configured.
RFID_API_URL=
# Required: separate QR Attendance application key issued for TDS-Printer.
# Keep on the server only; do not reuse FloorHub or other application keys.
RFID_API_TOKEN=
