{
  "_contract": "TDS-Printer <-> FloorHub cable-label print response contract.",
  "_copies": [
    "TDS-Printer/server/tests/contracts/cable_labels_contract.json",
    "FloorHub/backend/tests/contracts/cable_labels_contract.json"
  ],
  "_rule": "Both copies must stay byte-identical. TDS regenerates examples (TDS_CONTRACT_REGENERATE=1 pytest tests/test_cable_labels_contract.py); copy the file to FloorHub and update its expectations in the same change.",
  "endpoint": "POST /api/v1/integrations/projects/{external_project_id}/cable-labels",
  "compared_exactly": [
    "code",
    "ok",
    "printed",
    "printer_role",
    "printer_state",
    "requested",
    "role",
    "status"
  ],
  "error_codes": [
    "binding_missing",
    "binding_not_found",
    "default_missing",
    "idempotency_key_required",
    "in_progress_or_unknown",
    "key_conflict",
    "policy_missing",
    "printer_fault",
    "printer_not_allowed",
    "scope_forbidden",
    "template_not_found",
    "trunk_label_ambiguous",
    "trunk_label_not_found",
    "trunk_not_linked",
    "trunk_number_missing",
    "trunk_printer_not_allowed",
    "trunk_template_not_found"
  ],
  "examples": {
    "full_success": {
      "description": "Every requested leg label printed (Panduit printer with SNMP counter).",
      "status": 200,
      "headers": {},
      "sends_attempted": true,
      "body": {
        "ok": true,
        "requested": 2,
        "printed": 2,
        "discipline": "NET",
        "printer": "Cable",
        "results": [
          {
            "cable": "7.1",
            "status": "printed",
